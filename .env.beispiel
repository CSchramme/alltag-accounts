# Vorlage: nach .env kopieren und ausfüllen. .env kommt nie ins Git.
# Adresse dieser Konto-Seite und der App
PUBLIC_URL=https://accounts.alltag-app.de
APP_URL=https://alltag-app.de
# Gemeinsamer Schlüssel mit der App (gleicher Wert dort), mindestens 32 Zeichen, zufällig:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCOUNTS_SECRET=
# Nur fürs allererste Konto (wird Admin), wenn es noch keine Konten gibt
START_CODE=
# Mailversand über ein Plesk-Postfach (Port 587 mit STARTTLS oder 465 mit TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@alltag-app.de
SMTP_PASS=
MAIL_FROM=Alltag <noreply@alltag-app.de>
# Kontakt in Hinweis-Mails
LEGAL_EMAIL=
